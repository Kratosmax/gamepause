<Window x:Class="GamePause.App.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="560" Height="460" MinWidth="500" MinHeight="410"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="#F2F7FA" FontFamily="Segoe UI" Foreground="#1E293B"
        ShowInTaskbar="False" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="UpdateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E8FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="发现新版本" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Margin="0,7,0,0" Foreground="#5C6C7C" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,22,0,10" FontSize="12" FontWeight="SemiBold"
                   Foreground="#5C6C7C" Text="版本公告" />
        <Border Grid.Row="2" Background="#C7D4DD" />
        <ScrollViewer Grid.Row="3" Margin="0,13,0,16" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="22" Foreground="#435466" />
        </ScrollViewer>

        <StackPanel x:Name="ProgressPanel" Grid.Row="4" Margin="0,0,0,17" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="100"
                         Foreground="#2678F6" Background="#D7E1E8" />
            <TextBlock x:Name="StatusText" Margin="0,9,0,0" FontSize="12" FontWeight="SemiBold"
                       Foreground="#435466" TextWrapping="Wrap" />
            <TextBlock x:Name="RouteText" Margin="0,5,0,0" FontSize="11" Foreground="#66788A"
                       TextWrapping="Wrap" MaxHeight="38" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </StackPanel>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" MinWidth="112" Height="38" Content="跳过本版本"
                    Style="{StaticResource UpdateButtonStyle}" Click="Skip_Click" />
            <Button x:Name="LaterButton" Grid.Column="2" MinWidth="100" Height="38" Margin="0,0,10,0"
                    Content="暂不更新" Style="{StaticResource UpdateButtonStyle}" Click="Later_Click" />
            <Button x:Name="InstallButton" Grid.Column="3" MinWidth="108" Height="38" IsDefault="True"
                    Content="立即更新" Style="{StaticResource UpdateButtonStyle}"
                    Background="#2678F6" Foreground="White" Click="Update_Click" />
        </Grid>
    </Grid>
</Window>
