<Window x:Class="GamePause.App.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="510" Height="310" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F2F7FA" FontFamily="Segoe UI"
        Foreground="#1E293B" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="UpdateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E8FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Game Pause 有新版本" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,8,0,0" Foreground="#5C6C7C" />
        <Border Grid.Row="2" Margin="0,18,0,20" Padding="14" Background="#DFFFFFFF"
                BorderBrush="#BFCED9" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="#435466" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="跳过本版本" Width="112" Height="38" Style="{StaticResource UpdateButtonStyle}" Click="Skip_Click" />
            <Button Content="暂不更新" Width="100" Height="38" Margin="10,0,0,0"
                    Style="{StaticResource UpdateButtonStyle}" Click="Later_Click" />
            <Button Content="更新" Width="94" Height="38" Margin="10,0,0,0" IsDefault="True"
                    Style="{StaticResource UpdateButtonStyle}" Background="#2678F6" Foreground="White" Click="Update_Click" />
        </StackPanel>
    </Grid>
</Window>
