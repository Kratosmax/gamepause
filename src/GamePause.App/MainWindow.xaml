<Window x:Class="GamePause.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Pause"
        Width="1080" Height="780"
        MinWidth="920" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#1E293B"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5C6C7C" />
        <SolidColorBrush x:Key="BorderBrush" Color="#BFCED9" />
        <SolidColorBrush x:Key="GlassBrush" Color="#E3F8FBFD" />
        <SolidColorBrush x:Key="GridBrush" Color="#DDF8FBFD" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#E8FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource GridBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#DDE6EC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E6EDF3F7" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{Binding Foreground}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CFE1F4FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding RowBackground}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="9" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EFFFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootSurface" Background="#BDF2F7FA">
        <Grid Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="88" />
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="Game Pause" FontFamily="Segoe UI Variable Display" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="批量暂停单机游戏进程，并可靠恢复" Foreground="{StaticResource MutedBrush}" Margin="1,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="HibernateButton" Content="整机休眠" Background="#5C54D6" Style="{StaticResource FlatButtonStyle}"
                            Width="112" Click="HibernateButton_Click" />
                    <Button Content="设置" Style="{StaticResource SecondaryButtonStyle}"
                            Width="122" Margin="10,0,0,0" Click="HotkeyButton_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="18,10,14,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionLabel" Text="尚未勾选程序" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectionDetailLabel" Text="在“可暂停进程”中勾选一个或多个程序"
                                   Foreground="{StaticResource MutedBrush}" Margin="1,5,190,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                    <Button Content="3 秒捕获并勾选" Background="#1E293B" Style="{StaticResource FlatButtonStyle}"
                            Width="172" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CaptureButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PauseButton" Grid.Column="0" Content="暂停已勾选" Background="#1EB19D"
                        Style="{StaticResource FlatButtonStyle}" Margin="4,0" Click="PauseButton_Click" />
                <Button x:Name="DeepPauseButton" Grid.Column="1" Content="深度暂停已勾选" Background="#1991C3"
                        Style="{StaticResource FlatButtonStyle}" Margin="4,0" Click="DeepPauseButton_Click" />
                <Button x:Name="ResumeButton" Grid.Column="2" Content="恢复已勾选" Background="#2678F6"
                        Style="{StaticResource FlatButtonStyle}" Margin="4,0" Click="ResumeButton_Click" />
                <Button x:Name="EmergencyButton" Grid.Column="3" Content="紧急全部恢复" Background="#DA4352"
                        Style="{StaticResource FlatButtonStyle}" Margin="4,0" Click="EmergencyButton_Click" />
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="3">
                <TabItem Header="可暂停进程">
                    <Grid Margin="8,8,8,0">
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="进程" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,12,0" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                                     Padding="10,0" TextChanged="SearchBox_TextChanged"
                                     ToolTip="按进程名、窗口标题、PID 或游戏名搜索" />
                            <CheckBox x:Name="ForegroundOnlyCheck" Grid.Column="2" Content="仅当前前台"
                                      VerticalAlignment="Center" Margin="14,0,10,0" Checked="ForegroundOnlyCheck_Changed"
                                      Unchecked="ForegroundOnlyCheck_Changed" />
                            <TextBlock x:Name="ProcessCountLabel" Grid.Column="3" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" Margin="6,0,10,0" />
                            <Button Grid.Column="4" Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                    Width="74" Height="34" Click="RefreshButton_Click" />
                        </Grid>
                        <DataGrid x:Name="ProcessGrid" Grid.Row="1" Style="{StaticResource GridStyle}"
                                  ItemsSource="{Binding AvailableProcesses}" FrozenColumnCount="5">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="选择" Width="58" MinWidth="58" MaxWidth="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanSelect}" Checked="AvailableCheck_Changed" Unchecked="AvailableCheck_Changed" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="状态" Binding="{Binding State, Mode=OneWay}" IsReadOnly="True"
                                                    Width="88" MinWidth="88" MaxWidth="110" />
                                <DataGridTemplateColumn Header="兼容性" Width="108" MinWidth="108" MaxWidth="128" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Compatibility}" ToolTip="{Binding CompatibilityDetail}"
                                                   Foreground="{Binding CompatibilityBrush}" FontWeight="SemiBold" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="进程" Width="1.2*" MinWidth="190" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ProcessName}" VerticalAlignment="Center" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId, Mode=OneWay}" IsReadOnly="True"
                                                    Width="82" MinWidth="82" MaxWidth="82" />
                                <DataGridTemplateColumn Header="窗口" Width="2*" MinWidth="300" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding WindowTitle}" VerticalAlignment="Center" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="内存" Binding="{Binding Memory, Mode=OneWay}" IsReadOnly="True"
                                                    Width="100" MinWidth="100" MaxWidth="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="已暂停程序">
                    <Grid Margin="8,8,8,0">
                        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="勾选需要恢复的程序" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                            <TextBlock x:Name="PausedCountLabel" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                        </Grid>
                        <DataGrid x:Name="PausedGrid" Grid.Row="1" Style="{StaticResource GridStyle}"
                                  ItemsSource="{Binding PausedProcesses}" FrozenColumnCount="3">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="选择" Width="58" MinWidth="58" MaxWidth="58">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="PausedCheck_Changed" Unchecked="PausedCheck_Changed" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="程序" Width="1.5*" MinWidth="240" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="主 PID" Binding="{Binding ProcessId, Mode=OneWay}" IsReadOnly="True"
                                                    Width="90" MinWidth="90" MaxWidth="90" />
                                <DataGridTextColumn Header="暂停进程" Binding="{Binding ProcessCount, Mode=OneWay}" IsReadOnly="True"
                                                    Width="110" MinWidth="110" MaxWidth="120" />
                                <DataGridTextColumn Header="暂停时间" Binding="{Binding Since, Mode=OneWay}" IsReadOnly="True"
                                                    Width="150" MinWidth="150" MaxWidth="165" />
                                <DataGridTemplateColumn Header="状态" Width="1*" MinWidth="180" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="游戏档案">
                    <Grid Margin="8,8,8,0">
                        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="从已勾选创建" Style="{StaticResource SecondaryButtonStyle}" Width="132" Height="34"
                                        Click="AddProfileButton_Click" />
                                <Button Content="编辑" Style="{StaticResource SecondaryButtonStyle}" Width="74" Height="34" Margin="8,0,0,0"
                                        Click="EditProfileButton_Click" />
                                <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}" Width="74" Height="34" Margin="8,0,0,0"
                                        Click="DeleteProfileButton_Click" />
                                <Button Content="定位运行中程序" Style="{StaticResource SecondaryButtonStyle}" Width="132" Height="34" Margin="8,0,0,0"
                                        Click="LocateProfileButton_Click" />
                                <Button Content="暂停/恢复" Style="{StaticResource SecondaryButtonStyle}" Width="98" Height="34" Margin="8,0,0,0"
                                        Click="ToggleProfileButton_Click" />
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="ProfilesGrid" Grid.Row="1" Style="{StaticResource GridStyle}"
                                  ItemsSource="{Binding ProfileRows}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="游戏" Width="1.3*" MinWidth="190" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="进程" Width="1.2*" MinWidth="190" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="暂停方式" Binding="{Binding PauseMode, Mode=OneWay}" IsReadOnly="True"
                                                    Width="110" MinWidth="110" />
                                <DataGridTemplateColumn Header="自动规则" Width="1.4*" MinWidth="220" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding AutomaticRule}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AutomaticRule}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="当前状态" Binding="{Binding CurrentState, Mode=OneWay}" IsReadOnly="True"
                                                    Width="120" MinWidth="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="4">
                <TextBlock x:Name="StateLabel" Text="就绪" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HotkeyLabel" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>
