<Window x:Class="GamePause.App.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="520" Height="515"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" Foreground="#1E293B"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="92" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootSurface" Background="#DDF4F8FB" Padding="26,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" /><RowDefinition Height="58" />
                <RowDefinition Height="22" /><RowDefinition Height="34" />
                <RowDefinition Height="56" /><RowDefinition Height="56" />
                <RowDefinition Height="34" /><RowDefinition Height="58" />
                <RowDefinition Height="*" /><RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="常规" FontSize="17" FontWeight="SemiBold" />
            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="开机静默启动" FontWeight="SemiBold" />
                    <TextBlock Text="登录 Windows 后以最高权限进入系统托盘" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
                <CheckBox x:Name="StartupCheck" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="2" BorderBrush="#C8D4DE" BorderThickness="0,1,0,0" Margin="0,10,0,0" />
            <TextBlock Grid.Row="3" Text="快捷键" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom" />
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="暂停 / 恢复" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="ToggleBox" Grid.Column="1" Height="36" IsReadOnly="True"
                         VerticalContentAlignment="Center" Padding="10,0" PreviewKeyDown="ToggleBox_PreviewKeyDown" />
            </Grid>
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="紧急全部恢复" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="EmergencyBox" Grid.Column="1" Height="36" IsReadOnly="True"
                         VerticalContentAlignment="Center" Padding="10,0" PreviewKeyDown="EmergencyBox_PreviewKeyDown" />
            </Grid>
            <TextBlock Grid.Row="6" Margin="0,8,0,0" Foreground="#64748B"
                       Text="点击输入框后直接按组合键，至少包含 Ctrl、Alt 或 Shift。" />
            <TextBlock Grid.Row="7" Text="关于与更新" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom" />
            <Grid Grid.Row="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentVersionText" FontWeight="SemiBold" />
                    <TextBlock Text="启动时会在后台自动检查更新" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="CheckUpdateButton" Content="检查更新" Style="{StaticResource DialogButton}"
                        Width="104" Background="#E8FFFFFF" BorderBrush="#BFCED9"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="CheckUpdate_Click" />
            </Grid>
            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource DialogButton}" Background="#E8FFFFFF" BorderBrush="#BFCED9"
                        Click="Cancel_Click" IsCancel="True" />
                <Button Content="保存" Style="{StaticResource DialogButton}" Background="#2678F6" Foreground="White"
                        BorderBrush="#2678F6" Margin="10,0,0,0" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
