<Window x:Class="GamePause.App.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="设置" Width="720" Height="610"
        MinWidth="680" MinHeight="610"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" Foreground="#1E293B"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5C6C7C" />
        <SolidColorBrush x:Key="BorderBrush" Color="#BFCED9" />
        <SolidColorBrush x:Key="GridBrush" Color="#DDF8FBFD" />
        <x:Array x:Key="PriorityValues" Type="{x:Type sys:Int32}">
            <sys:Int32>0</sys:Int32><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32><sys:Int32>5</sys:Int32>
            <sys:Int32>6</sys:Int32><sys:Int32>7</sys:Int32><sys:Int32>8</sys:Int32>
            <sys:Int32>9</sys:Int32><sys:Int32>10</sys:Int32>
        </x:Array>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#E8FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SettingsGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource GridBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#DDE6EC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E6EDF3F7" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CFE1F4FF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridTextElementStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Address}" />
        </Style>
        <Style x:Key="GridTextEditingStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="#9CCBF1" />
            <Setter Property="SelectionTextBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="GridComboStyle" TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="9" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EFFFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootSurface" Background="#BDF2F7FA" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>
            <TabControl x:Name="SettingsTabs">
                <TabItem Header="常规与快捷键">
                    <Grid Margin="18,16,18,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" /><RowDefinition Height="62" />
                            <RowDefinition Height="62" /><RowDefinition Height="24" />
                            <RowDefinition Height="36" /><RowDefinition Height="62" />
                            <RowDefinition Height="62" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="常规" FontSize="17" FontWeight="SemiBold" />
                        <Grid Grid.Row="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="开机静默启动" FontWeight="SemiBold" />
                                <TextBlock Text="普通权限静默进入托盘；受限目标按需提权" Foreground="#64748B" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="StartupCheck" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Debug 模式" FontWeight="SemiBold" />
                                <TextBlock Text="记录进程树、父子关系和程序路径" Foreground="#64748B" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="DebugModeCheck" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="#C8D4DE" BorderThickness="0,1,0,0" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="4" Text="快捷键" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="暂停 / 恢复" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox x:Name="ToggleBox" Grid.Column="1" Height="36" IsReadOnly="True"
                                     VerticalContentAlignment="Center" Padding="10,0" PreviewKeyDown="ToggleBox_PreviewKeyDown" />
                        </Grid>
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="紧急全部恢复" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox x:Name="EmergencyBox" Grid.Column="1" Height="36" IsReadOnly="True"
                                     VerticalContentAlignment="Center" Padding="10,0" PreviewKeyDown="EmergencyBox_PreviewKeyDown" />
                        </Grid>
                        <TextBlock Grid.Row="7" Margin="0,8,0,0" Foreground="#64748B" TextWrapping="Wrap"
                                   Text="点击输入框后直接按组合键，至少包含 Ctrl、Alt 或 Shift。" />
                    </Grid>
                </TabItem>
                <TabItem Header="网络与更新">
                    <Grid Margin="18,16,18,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" /><RowDefinition Height="*" />
                            <RowDefinition Height="38" /><RowDefinition Height="18" />
                            <RowDefinition Height="66" /><RowDefinition Height="18" />
                            <RowDefinition Height="62" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="GitHub 访问线路" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+" Style="{StaticResource IconButton}" ToolTip="添加 GitHub 加速地址"
                                        Click="AddProxy_Click" />
                                <Button Content="−" Style="{StaticResource IconButton}" ToolTip="删除所选 GitHub 加速地址"
                                        Margin="8,0,0,0" Click="RemoveProxy_Click" />
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="GithubProxyGrid" Grid.Row="1" Margin="0,8,0,0"
                                  Style="{StaticResource SettingsGridStyle}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  BeginningEdit="GithubProxyGrid_BeginningEdit">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="地址" Width="*"
                                                    Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource GridTextElementStyle}"
                                                    EditingElementStyle="{StaticResource GridTextEditingStyle}" />
                                <DataGridComboBoxColumn Header="优先级" Width="92"
                                    ItemsSource="{StaticResource PriorityValues}"
                                    ElementStyle="{StaticResource GridComboStyle}"
                                    EditingElementStyle="{StaticResource GridComboStyle}"
                                    SelectedItemBinding="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="#64748B" TextWrapping="Wrap"
                                   Text="按优先级 10 到 1 依次尝试；0 表示禁用。同优先级按列表顺序。" />
                        <Border Grid.Row="3" BorderBrush="#C8D4DE" BorderThickness="0,1,0,0" Margin="0,10,0,0" />
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HTTP 网络代理" FontWeight="SemiBold" />
                                <TextBlock Text="可选" Foreground="#64748B" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBox x:Name="HttpProxyBox" Grid.Column="1" Height="36" VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" Padding="10,0"
                                     ToolTip="例如：http://127.0.0.1:7890" />
                        </Grid>
                        <Border Grid.Row="5" BorderBrush="#C8D4DE" BorderThickness="0,1,0,0" Margin="0,10,0,0" />
                        <Grid Grid.Row="6">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentVersionText" FontWeight="SemiBold" />
                                <TextBlock Text="启动时会在后台自动检查更新" Foreground="#64748B" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="CheckUpdateButton" Content="检查更新" Style="{StaticResource DialogButton}"
                                    Background="#E8FFFFFF" BorderBrush="#BFCED9"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="CheckUpdate_Click" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="取消" Style="{StaticResource DialogButton}" Background="#E8FFFFFF" BorderBrush="#BFCED9"
                        Click="Cancel_Click" IsCancel="True" />
                <Button Content="保存" Style="{StaticResource DialogButton}" Background="#2678F6" Foreground="White"
                        BorderBrush="#2678F6" Margin="10,0,0,0" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
